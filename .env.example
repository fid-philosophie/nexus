### General

APP_PORT=8000

## for reverse proxy
APP_ROOT_PATH=/nexus

## should only be enabled in safe environments (e.g. running the API locally)
ENABLE_CUSTOM_MAPPINGS=False

## API contact in request header
API_CONTACT_NAME="Example Organisation"
API_CONTACT_EMAIL=api@example.org # will be visible in OpenAPI docs

## Requests to upstream data sources
HTTP_USER_AGENT="NexusAPI/0.9 (+https://example.org/nexus)""

# -----------------------------------------------------------------------------

### Compose setup

## Setup 1: use an existing Redis instance
## You will need to set REDIS_URL below!
# COMPOSE_FILE=compose.yaml

## Setup 2: start Redis together with Nexus
COMPOSE_FILE=compose.yaml:compose.redis.yaml

# -----------------------------------------------------------------------------

### CORS
ALLOW_ORIGINS=[]
# ALLOW_ORIGINS=["http://127.0.0.1:8000"] # if you want to allow a local frontend to access Nexus directly

# -----------------------------------------------------------------------------

### Redis configuration

## Setup 1
# REDIS_URL=rediss://nexus:URL_ENCODED_PASSWORD@redis.internal.example:6379/0

## Setup 2
## Connection to the Redis service supplied by compose.redis.yaml
REDIS_URL=redis://redis:6379/0